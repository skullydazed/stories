# Toolchain files and explicit compiler choices take precedence over our defaults.
if(NOT CMAKE_C_COMPILER AND "$ENV{CC}" STREQUAL "" AND NOT CMAKE_TOOLCHAIN_FILE AND "$ENV{CMAKE_TOOLCHAIN_FILE}" STREQUAL "")
	find_program(CMAKE_C_COMPILER NAMES clang gcc cc REQUIRED)
endif()
if(NOT CMAKE_CXX_COMPILER AND "$ENV{CXX}" STREQUAL "" AND NOT CMAKE_TOOLCHAIN_FILE AND "$ENV{CMAKE_TOOLCHAIN_FILE}" STREQUAL "")
	# Prefer the selected C driver's companion before searching PATH. A full LLVM C compiler can otherwise be paired with Apple clang++, which lacks libFuzzer.
	set(stories_c_driver "${CMAKE_C_COMPILER}")
	if(NOT stories_c_driver)
		get_filename_component(stories_c_driver "$ENV{CC}" PROGRAM PROGRAM_ARGS stories_c_driver_args)
	elseif(NOT IS_ABSOLUTE "${stories_c_driver}")
		get_filename_component(stories_c_driver "${stories_c_driver}" PROGRAM)
	endif()
	get_filename_component(stories_c_directory "${stories_c_driver}" DIRECTORY)
	get_filename_component(stories_c_name "${stories_c_driver}" NAME)
	set(stories_cxx_name "")
	if(stories_c_name MATCHES "^clang(-[0-9.]+)?$")
		string(REGEX REPLACE "^clang" "clang++" stories_cxx_name "${stories_c_name}")
	elseif(stories_c_name MATCHES "^gcc(-[0-9.]+)?$")
		string(REGEX REPLACE "^gcc" "g++" stories_cxx_name "${stories_c_name}")
	elseif(stories_c_name STREQUAL "cc")
		set(stories_cxx_name "c++")
	endif()
	if(stories_cxx_name AND stories_c_directory)
		find_program(CMAKE_CXX_COMPILER NAMES "${stories_cxx_name}" PATHS "${stories_c_directory}" NO_DEFAULT_PATH)
	endif()
	find_program(CMAKE_CXX_COMPILER NAMES clang++ g++ c++ REQUIRED)
endif()
