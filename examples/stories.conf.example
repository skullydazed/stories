# Copy to stories.conf and adjust the site settings below.
# Paths are relative to this configuration file. Create both roots before starting.
[server]
#listen = 127.0.0.1:8080
#threads = 8

# Omit either path to keep access logs on stdout and errors on stderr.
# Files are appended; parent directories must exist. SIGUSR1 reopens the files.
[logging]
#access_log = /var/log/stories/access.log
#error_log = /var/log/stories/error.log

[content]
root = docroot
#resolution_order = 

# Byte limits apply independently to source and complete HTML output.
#markdown_limit = 8388608
#output_limit = 33554432

[site]
title = Stories
template = templates/page.html
# Edit the HTML template to change layout, stylesheet links, or light/dark mode.
# Template edits appear on the next uncached request.

[navigation]
# Anything defined here will be added as navigational links in the default layout.
Home = /

[assets]
root = assets
